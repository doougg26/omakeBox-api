{
  "name": "omakebox-backend",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "description": "OmakeBox API - Anime tracking and social platform",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.3",
    "uuid": "^12.0.1"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^12.0.1"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.5"
  }
}
